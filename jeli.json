{
    "name": "jeli",
    "projects": {
        "core": {
            "sourceRoot": "packages/core",
            "type": "library",
            "output": {
                "generateMeta": true,
                "patterns": ["UMD", "MODULE"],
                "folder": "dist/core",
                "files": {
                    "@jeli/core": "./public.api.js"
                },
                "copy": [
                    { "src": "packages/core/index.d.ts", "dest": "/index.d.ts" },
                    { "src": "packages/core/README.md", "dest": "/README.md" }
                ]
            }
        },
        "common": {
            "type": "library",
            "sourceRoot": "packages/common",
            "output": {
                "generateMeta": true,
                "patterns": ["UMD", "MODULE"],
                "folder": "dist/common",
                "files": {
                    "@jeli/common": "./public.api.js",
                    "@jeli/common/*": "./*/public.api.js"
                },
                "copy": [
                    { "src": "packages/common/index.d.ts", "dest": "/index.d.ts" },
                    { "src": "packages/common/README.md", "dest": "/README.md" }
                ]
            },
            "resolve": {
                "alias": {
                    "@jeli/core": "./dist/core"
                }
            }
        },
        "form": {
            "sourceRoot": "packages/form",
            "type": "library",
            "output": {
                "generateMeta": true,
                "patterns": ["UMD", "MODULE"],
                "folder": "dist/form",
                "files": {
                    "@jeli/form": "./public.api.js"
                },
                "copy": [
                    { "src": "packages/form/index.d.ts", "dest": "/index.d.ts" },
                    { "src": "packages/form/README.md", "dest": "/README.md" }
                ]
            },
            "resolve": {
                "alias": {
                    "@jeli/core": "./dist/core"
                }
            }
        },
        "http": {
            "sourceRoot": "packages/http",
            "type": "library",
            "output": {
                "generateMeta": true,
                "patterns": ["UMD", "MODULE"],
                "folder": "dist/http",
                "files": {
                    "@jeli/http": "./public.api.js"
                },
                "copy": [
                    { "src": "packages/http/index.d.ts", "dest": "/index.d.ts" },
                    { "src": "packages/http/README.md", "dest": "/README.md" }
                ]
            },
            "resolve": {
                "alias": {
                    "@jeli/core": "./dist/core"
                }
            }
        },
        "router": {
            "sourceRoot": "packages/router",
            "type": "library",
            "output": {
                "generateMeta": true,
                "patterns": ["UMD", "MODULE"],
                "folder": "dist/router",
                "files": {
                    "@jeli/router": "./public.api.js"
                },
                "copy": [
                    { "src": "packages/router/index.d.ts", "dest": "/index.d.ts" },
                    { "src": "packages/router/README.md", "dest": "/README.md" }
                ]
            },
            "resolve": {
                "alias": {
                    "@jeli/core": "./dist/core"
                }
            }
        },
        "examples": {
            "type": "application",
            "sourceRoot": "viewers/Todo/src",
            "output": {
                "folder": "./docs/examples/Todo/",
                "view": "index.html",
                "styles": ["viewers/Todo/src/styles.scss"],
                "entryFile": "main.js"
            },
            "resolve": {
                "alias": {
                    "@jeli/*": "./dist/",
                    "@jeli/common/datetime": "./dist/common/datetime"
                }
            }
        }
    },
    "resolve": {
        "alias": {
            "@jeli/helpers":  "../js-helpers/"
        }
    },
    "default": "core"
}